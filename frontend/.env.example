# ── Clean-It Frontend Environment Configuration ──────────────────────

# Backend API URL
# In local development: leave empty to use Vite's built-in proxy (http://127.0.0.1:8000).
# In production on Vercel: set to your deployed Render service URL (e.g. https://clean-it-backend.onrender.com).
VITE_API_URL=https://your-clean-it-backend.onrender.com

# Supabase Auth Configuration (Optional)
# If omitted, the frontend automatically retrieves these from your backend's /api/v1/auth/config endpoint.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
