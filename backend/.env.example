GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Resource limits ────────────────────────────────────────────────────────────
# Render free tier: 512 MB RAM, 0.1 vCPU, ephemeral filesystem.
# Peak RAM during CSV processing ≈ 6× file size (parse + profile + convert).
# 312 MB available ÷ 6 = 52 MB → 50 MB safe max.
# Increase on paid Render plans (e.g. 200 MB on 1c-2g = ~1 GB safe).
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=500000
MAX_COLUMNS=150
MAX_CONCURRENT_JOBS=1
