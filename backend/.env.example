# ── Clean-It Backend Environment Configuration ──────────────────────

# AI Engine (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Supabase Database & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Application Environment (use "production" on Render, "development" locally)
ENVIRONMENT=production
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Set to "*" to allow any domain, or comma-separated list of allowed origins:
# e.g. https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Resource Limits & Processing Safety
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=500000
MAX_COLUMNS=150
MAX_CONCURRENT_JOBS=1
